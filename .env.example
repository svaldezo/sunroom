# ── Sunroom configuration ────────────────────────────────────────────────
# Copy to .env for local work; set the same names in Vercel's project
# settings for production. Everything without a default is required in
# production -- the app refuses to boot without them rather than starting up
# insecure, so a missing value is a failed deploy, not a quiet vulnerability.

# ── environment ─────────────────────────────────────────────────────────
SUNROOM_ENV=production                 # development | production

# ── Supabase ────────────────────────────────────────────────────────────
# Project settings → API. The service role key bypasses RLS: it belongs on
# the server and must never reach the browser or a git history.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...              # public; the browser gets this one
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # secret; server only
SUPABASE_JWT_SECRET=...               # Settings → API → JWT Settings

# Project settings → Database → Connection string → Transaction pooler.
# Use the POOLER (port 6543), not the direct connection: serverless creates
# many short-lived clients and the direct port runs out of connections.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── model ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # the shared key, for accounts without one
PRISM_PROVIDER=anthropic              # never 'mock' in production
PRISM_MODEL=claude-sonnet-4-5

# ── secrets ─────────────────────────────────────────────────────────────
# Generate both:  openssl rand -base64 48
SUNROOM_SECRET_KEY=                   # encrypts users' own API keys at rest
SUNROOM_WORKER_SECRET=                # authenticates the job worker endpoint

# ── limits ──────────────────────────────────────────────────────────────
SUNROOM_TOKEN_BUDGET=2000000          # per account per month, without own key
SUNROOM_MAX_UPLOAD=104857600          # 100 MB
SUNROOM_RATE_LIMIT=120                # requests per minute per caller
SUNROOM_SLICE_SECONDS=45              # keep below the function's maxDuration

# ── optional ────────────────────────────────────────────────────────────
# SUNROOM_ALLOWED_EMAIL_DOMAINS=umd.edu   # limit signups to these domains
# SUNROOM_ORIGINS=https://sunroom.app     # CORS, only if a separate frontend
# SUNROOM_BUCKET=sources
# SUNROOM_PG_POOL=4
